          "icon_config": "[{\"id\":7,\"name_zh\":\"衍生品电子票\",\"name_en\":\"Derivative e-ticket\",\"icon\":\"admin/ticketIcon/1719727959363/check.png\"},{\"id\":2,\"name_zh\":\"实名入场\",\"name_en\":\"Admission by name\",\"icon\":\"admin/ticket_detail/1719725175151/check.png\"},{\"id\":9,\"name_zh\":\"不可转赠\",\"name_en\":\"non-transferable\",\"icon\":\"admin/ticketIcon/1719891441028/remove.png\"},{\"id\":4,\"name_zh\":\"条件退\",\"name_en\":\"Conditional refund\",\"icon\":\"admin/ticket_detail/1719725245925/donate.png\"}]",
