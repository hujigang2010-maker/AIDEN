/** app.wxss — NYU Violet #57068C 高饱和紫调（避免灰感） */
page {
  --primary: #57068c;
  --primary-deep: #330662;
  --primary-bright: #8900e1;
  --primary-soft: #a78bc4;
  --primary-wash: #f0e6f8;
  --gold: #c5a572;
  --bg: #f0e6f8;
  --card: #ffffff;
  --text: #1a0a2e;
  --muted: #5c3d7a;
  --line: #dcc8ec;
  --danger: #b83280;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC",
    "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

.container {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-title .h {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 1rpx;
}

.section-title .more {
  font-size: 24rpx;
  color: var(--primary-bright);
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(87, 6, 140, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(87, 6, 140, 0.08);
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-teal {
  background: rgba(87, 6, 140, 0.12);
  color: var(--primary);
}

.tag-gold {
  background: rgba(197, 165, 114, 0.22);
  color: #8a6a32;
}

.tag-free {
  background: rgba(87, 6, 140, 0.08);
  color: var(--primary-deep);
}

.tag-paid {
  background: rgba(184, 50, 128, 0.12);
  color: var(--danger);
}

.btn-primary {
  background: linear-gradient(135deg, #330662 0%, #57068c 45%, #8900e1 100%);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 650;
  box-shadow: 0 12rpx 28rpx rgba(87, 6, 140, 0.28);
}

.btn-ghost {
  border: 2rpx solid var(--primary);
  color: var(--primary);
  border-radius: 999rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.85);
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.price {
  color: var(--danger);
  font-weight: 700;
}
