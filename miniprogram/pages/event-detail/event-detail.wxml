<view class="container" wx:if="{{event}}">
  <view class="head card">
    <view class="top">
      <text class="tag tag-teal">{{event.type}}</text>
      <text class="tag {{event.paid ? 'tag-paid' : 'tag-free'}}">{{event.status}}</text>
    </view>
    <view class="title">{{event.title}}</view>
    <view class="muted">{{event.date}} · {{event.time}}</view>
    <view class="muted">{{event.place}} · {{event.city}}</view>
    <view class="summary">{{event.summary}}</view>
  </view>

  <view class="section-title"><text class="h">议程</text></view>
  <view class="card">
    <view class="agenda" wx:for="{{event.agenda}}" wx:key="time">
      <text class="time">{{item.time}}</text>
      <text class="item">{{item.item}}</text>
    </view>
  </view>

  <view class="section-title"><text class="h">选择票种</text></view>
  <view
    class="card ticket {{ticketIndex === index ? 'on' : ''}}"
    wx:for="{{event.tickets}}"
    wx:key="id"
    data-index="{{index}}"
    bindtap="onSelectTicket"
  >
    <view class="ticket-name">{{item.name}}</view>
    <view class="muted">{{item.desc}}</view>
    <view class="price">{{item.price > 0 ? '¥' + item.price : '免费'}}</view>
  </view>

  <view class="footer">
    <view class="btn-primary" bindtap="onPay">
      {{event.tickets[ticketIndex].price > 0 ? '确认报名并支付' : '确认免费报名'}}
    </view>
  </view>
</view>
