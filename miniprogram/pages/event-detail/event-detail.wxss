.head .title {
  margin: 16rpx 0 10rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.top {
  display: flex;
  justify-content: space-between;
}

.summary {
  margin-top: 16rpx;
  color: var(--muted);
}

.tools {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 12rpx;
  margin: 8rpx 0 20rpx;
}

.tool {
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  background: #fff;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 650;
  border: 1rpx solid rgba(87, 6, 140, 0.14);
  box-shadow: 0 6rpx 16rpx rgba(87, 6, 140, 0.08);
}

.agenda {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.agenda:last-child {
  border-bottom: none;
}

.time {
  width: 140rpx;
  color: var(--teal);
  font-weight: 600;
  flex-shrink: 0;
}

.ticket.on {
  border: 2rpx solid var(--primary);
  background: rgba(87, 6, 140, 0.06);
}

.ticket-name {
  font-weight: 650;
  margin-bottom: 6rpx;
}

.ticket .price {
  margin-top: 12rpx;
}

.tip-card {
  margin-top: 8rpx;
}

.tip-title {
  font-weight: 650;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.footer {
  position: sticky;
  bottom: 0;
  padding: 20rpx 0 12rpx;
  background: linear-gradient(180deg, rgba(240, 230, 248, 0), #f0e6f8 30%);
}
