.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.about-hero {
  margin: 8rpx 36rpx 32rpx;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #123F55, #0B7584);
  color: #fff;
}

.label {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: #C4A574;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 26rpx;
  opacity: 0.88;
  margin-bottom: 24rpx;
}

.desc {
  font-size: 24rpx;
  line-height: 1.75;
  opacity: 0.85;
}

.more-btn {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #C4A574;
  font-weight: 600;
}

.extra {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.75;
  opacity: 0.85;
}

.dir {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 1px solid #D8E2E8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #123F55;
}

.dir-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #E8F2F4;
  color: #0B7584;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.contact {
  margin: 16rpx 36rpx 32rpx;
  padding: 32rpx;
  background: #fff;
  border: 1px solid #D8E2E8;
  border-radius: 28rpx;
}

.contact-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #123F55;
  margin-bottom: 8rpx;
}

.contact-hint {
  font-size: 24rpx;
  color: #5A6F7A;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.label-sm {
  width: 64rpx;
  color: #5A6F7A;
  font-size: 24rpx;
  flex-shrink: 0;
}

.link {
  color: #0B7584;
  font-weight: 500;
}

.copyright {
  text-align: center;
  font-size: 20rpx;
  color: #9AABB4;
  padding: 8rpx 0 32rpx;
}
