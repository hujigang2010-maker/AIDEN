.page {
  padding: 24rpx 40rpx 64rpx;
  min-height: 100vh;
}

.badge-wrap {
  margin-bottom: 20rpx;
}

.type-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #0B7584;
  background: #E8F2F4;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #123F55;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.meta {
  font-size: 24rpx;
  color: #5A6F7A;
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1px solid #D8E2E8;
}

.lead {
  font-size: 28rpx;
  line-height: 1.8;
  color: #1A2B34;
  margin-bottom: 24rpx;
}

.body {
  font-size: 26rpx;
  line-height: 1.85;
  color: #5A6F7A;
}

.demo-tip {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #A17C4C;
}
