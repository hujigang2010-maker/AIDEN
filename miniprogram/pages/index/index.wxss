.page {
  min-height: 100vh;
  background: #F3F6F8;
  padding-bottom: 24rpx;
}

.hero {
  padding: 0 44rpx 56rpx;
  background: linear-gradient(165deg, #0E2F40 0%, #123F55 45%, #0B7584 100%);
  color: #fff;
}

.status-safe {
  height: 88rpx;
}

.nav-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 48rpx;
}

.hero-brand {
  font-size: 22rpx;
  letter-spacing: 0.22em;
  color: #C4A574;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.hero-aux {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 36rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.hero-actions button {
  margin: 0;
  line-height: 1.4;
}

.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.entry {
  background: #fff;
  border: 1px solid #D8E2E8;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #123F55;
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #5A6F7A;
  line-height: 1.5;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.more {
  font-size: 24rpx;
  color: #0B7584;
}

.feed {
  background: #fff;
  border: 1px solid #D8E2E8;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.feed-type {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  color: #0B7584;
  background: #E8F2F4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.feed-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 10rpx;
}

.feed-summary {
  font-size: 24rpx;
  color: #5A6F7A;
  line-height: 1.55;
}

.copyright {
  text-align: center;
  font-size: 20rpx;
  color: #9AABB4;
  padding: 16rpx 0 32rpx;
}
