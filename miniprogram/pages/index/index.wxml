<view class="page">
  <view class="hero">
    <view class="hero-glow"></view>
    <view class="eyebrow">FUDAN LINK</view>
    <view class="brand">{{platform.fullName}}</view>
    <view class="motto">{{platform.motto}}</view>
    <view class="sponsor">{{platform.sponsorNote}}</view>
    <view class="hero-actions">
      <view class="btn-primary hero-btn" bindtap="onEntryTap" data-item="{{quickEntries[0]}}">浏览活动</view>
      <view class="btn-outline" bindtap="goAbout">关于平台</view>
    </view>
  </view>

  <view class="container">
    <view class="entries">
      <view
        class="entry {{item.highlight ? 'entry-hot' : ''}}"
        wx:for="{{quickEntries}}"
        wx:key="id"
        bindtap="onEntryTap"
        data-item="{{item}}"
      >
        <view class="entry-title">{{item.title}}</view>
        <view class="entry-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-title">
      <text class="h">即将开始</text>
      <text class="more" bindtap="onEntryTap" data-item="{{quickEntries[0]}}">全部活动</text>
    </view>
    <view
      class="card event-card"
      wx:for="{{upcoming}}"
      wx:key="id"
      bindtap="onEventTap"
      data-id="{{item.id}}"
    >
      <view class="row-top">
        <text class="tag tag-teal">{{item.type}}</text>
        <text class="tag {{item.paid ? 'tag-paid' : 'tag-free'}}">{{item.paid ? '收费' : '免费'}}</text>
      </view>
      <view class="event-title">{{item.title}}</view>
      <view class="muted">{{item.date}} · {{item.time}} · {{item.place}}</view>
      <view class="row-bottom">
        <text class="status">{{item.status}}</text>
        <text class="price" wx:if="{{item.paid}}">¥{{item.priceFrom}} 起</text>
        <text class="price free" wx:else>免费报名</text>
      </view>
    </view>

    <view class="section-title"><text class="h">平台动态</text></view>
    <view class="card feed" wx:for="{{feeds}}" wx:key="title" bindtap="onFeedTap" data-ref="{{item.ref}}">
      <text class="tag tag-gold">{{item.type}}</text>
      <view class="feed-title">{{item.title}}</view>
      <view class="muted">{{item.summary}}</view>
    </view>
  </view>
</view>
