<view class="container">
  <view class="card">
    <view class="label">订单内容</view>
    <view class="title">{{title}}</view>
    <view class="muted">{{ticketName}}</view>
    <view class="amount-row">
      <text>应付金额</text>
      <text class="price">{{price > 0 ? '¥' + price : '免费'}}</text>
    </view>
  </view>

  <view class="card tip">
    <view class="label">收费入口说明</view>
    <view class="muted">对标管院校友平台捐赠支付与 EE 课程招生：活动票、培训学费/定金、会员年费、支持中心均可由此闭环。正式环境接入微信支付商户号与退款规则。</view>
  </view>

  <view class="btn-primary" bindtap="submit">{{price > 0 ? '微信支付（演示）' : '确认报名'}}</view>
</view>
