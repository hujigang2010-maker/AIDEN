.hero-card .title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 10rpx;
}
.step {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
  align-items: flex-start;
}
.step:last-child { border-bottom: none; }
.num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 40rpx;
  flex-shrink: 0;
}
.txt { flex: 1; color: var(--text); font-size: 26rpx; }
.label {
  margin: 16rpx 0 8rpx;
  color: var(--primary);
  font-weight: 650;
  font-size: 24rpx;
}
input, textarea {
  background: var(--primary-wash);
  padding: 16rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}
textarea { min-height: 140rpx; }
